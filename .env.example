# Supabase (client-side, safe to expose — protected by Row Level Security)
# Vercel: you can keep your existing NEXT_PUBLIC_* names, they are read too.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Next-style equivalents (also accepted, e.g. existing Vercel env vars):
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
